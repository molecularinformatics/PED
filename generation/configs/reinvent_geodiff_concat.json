{
  "version": 3,
  "run_type": "reinforcement_learning",
  "logging": {
    "sender": "http://127.0.0.1",
    "recipient": "local",
    "logging_frequency": 10,
    "logging_path": "results/generation/reinvent_geodiff_concat/progress.log",
    "result_folder": "results/generation/reinvent_geodiff_concat/results",
    "job_name": "reinvent_geodiff_concat",
    "job_id": "reinvent_geodiff_concat"
  },
  "parameters": {
    "scoring_function": {
      "name": "custom_sum",
      "parallel": false,
      "parameters": [
        {
          "component_type": "geodiff_distance",
          "name": "GeoDiff concat_norm Euclidean PED",
          "weight": 1,
          "specific_parameters": {
            "reference_smiles": "C/C=C/C(=O)N[C@H]1CCCN(c2c(F)cc(C(N)=O)c3[nH]c(C)c(C)c23)C1",
            "ckpt_path": "external/checkpoints/geodiff/model/checkpoints/drugs_default.pt",
            "embedding_mode": "concat_norm",
            "distance_metric": "euclidean",
            "transformation": {
              "transformation_type": "reverse_sigmoid",
              "low": 0.1,
              "high": 0.58,
              "k": 0.25
            }
          }
        }
      ]
    },
    "diversity_filter": {
      "name": "NoFilter",
      "bucket_size": 25,
      "minscore": 0.0,
      "minsimilarity": 0.4
    },
    "inception": {
      "smiles": [],
      "memory_size": 100,
      "sample_size": 10
    },
    "reinforcement_learning": {
      "prior": "generation/external/priors/augmented.prior",
      "agent": "generation/external/priors/augmented.prior",
      "n_steps": 10000,
      "sigma": 128,
      "learning_rate": 0.0001,
      "batch_size": 128,
      "margin_threshold": 50
    }
  }
}
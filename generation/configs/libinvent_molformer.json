{
  "version": 3,
  "run_type": "lib_invent_reinforcement_learning",
  "logging": {
    "logging_path": "results/generation/libinvent_molformer/progress.log",
    "result_folder": "results/generation/libinvent_molformer/results",
    "job_name": "libinvent_molformer",
    "job_id": "libinvent_molformer",
    "sender": "http://127.0.0.1",
    "recipient": "local"
  },
  "parameters": {
    "actor": "generation/external/priors/library_design.prior",
    "critic": "generation/external/priors/library_design.prior",
    "scaffolds": [
      "CC=CC([*:0])=O"
    ],
    "n_steps": 5000,
    "learning_rate": 0.0001,
    "batch_size": 128,
    "randomize_scaffolds": false,
    "learning_strategy": {
      "name": "dap",
      "parameters": {
        "sigma": 120
      }
    },
    "scoring_strategy": {
      "name": "lib_invent",
      "scoring_function": {
        "name": "custom_sum",
        "parallel": false,
        "parameters": [
          {
            "component_type": "molformer_distance",
            "name": "MoLFormer Euclidean PED",
            "weight": 1,
            "specific_parameters": {
              "reference_smiles": "C/C=C/C(=O)N[C@H]1CCCN(c2c(F)cc(C(N)=O)c3[nH]c(C)c(C)c23)C1",
              "model_name": "ibm/MoLFormer-XL-both-10pct",
              "distance_metric": "euclidean",
              "transformation": {
                "transformation_type": "reverse_sigmoid",
                "low": 6,
                "high": 15,
                "k": 0.25
              }
            }
          }
        ]
      },
      "diversity_filter": {
        "name": "NoFilterWithPenalty",
        "bucket_size": 25,
        "minscore": 0.0,
        "minsimilarity": 0.4
      },
      "reaction_filter": {
        "type": "selective",
        "reactions": []
      }
    }
  }
}